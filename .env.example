# Copy to .env and fill in your values.
#
# AUTHENTICATION — two ways, and for a real deployment prefer the second.
#
# 1) A session token on its own. It works, but Ory session tokens EXPIRE: the
#    day it does, every request 401s until someone restarts the container with a
#    freshly pasted one. The process stays healthy the whole time, so nothing
#    upstream notices -- it just cannot talk to Mistral any more.
MISTRAL_SESSION_TOKEN=
#
# 2) Email + password. With these set the proxy logs in by itself at startup
#    when no token is configured, AND logs in again when an upstream call comes
#    back 401/403, replaying that request once. A deployment holding these
#    recovers on its own; one holding only a token does not.
MISTRAL_EMAIL=
MISTRAL_PASSWORD=

# Debug logging
DEBUG=false
